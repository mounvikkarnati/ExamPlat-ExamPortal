# ===== ExamPlat Final Exam Portal - Server environment =====
# Copy to ".env" and fill in real values. NEVER commit real secrets.

# MongoDB Atlas connection string (SAMPLE with placeholders - replace with your real URI).
# MUST point at the same cluster/database already used by the Admin Portal
# (the collections touched are: finalexams, finalallowedcandidates, finalquestions,
#  finalattempts, students).
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/examplat?retryWrites=true&w=majority&appName=ExamPlat

# HTTP port for the API server
PORT=5030

# JWT signing secret (use a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Frontend origin(s) allowed by CORS (comma-separated if more than one)
CLIENT_ORIGIN=http://localhost:5175